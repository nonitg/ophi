#!/bin/bash
# Drive the ABELDent UI on the lab VM. Thin wrapper over lab/vm/guest/ui.ps1 via `vm uexec`.
#   scripts/ui windows | tree [-Name X] [-Depth N] | click -Name X | type -Text '...' | keys -Text '{ENTER}' | read -Name X
# Each shell arg becomes one single-quoted PowerShell arg, so names with spaces survive.
cd "$(dirname "$0")/.." || exit 1
args=""
for a in "$@"; do
  case "$a" in
    -*) args="$args $a" ;;
    *)  args="$args '${a//\'/\'\'}'" ;;
  esac
done
out="$(./lab/vm/vm uexec "& C:\ophi\ui.ps1$args")"
printf '%s\n' "$out"
# The guest exit code does not travel back through the scheduled task; judge on content.
case "$out" in *"not found"*|*"no edit found"*|*"timeout:"*|*"unknown verb"*|*"Exception"*) exit 1 ;; esac
