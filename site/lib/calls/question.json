  "turns": [
    {
      "who": "ophi",
      "start": 0.3,
      "end": 4.18,
      "text": "Hi, I'm Ophi. Welcome to our dental office. How can I help you today?"
    },
    {
      "who": "caller",
      "start": 5.33,
      "end": 8.65,
      "text": "Hi there. Do you folks take the Canadian Dental Care Plan?"
    },
    {
      "who": "ophi",
      "start": 10.2,
      "end": 19.52,
      "text": "Yes, we do accept the Canadian Dental Care Plan. Coverage depends on your own plan, and the team confirms the details at your visit. Would you like me to book you a visit?"
    },
    {
      "who": "caller",
      "start": 20.62,
      "end": 24.11,
      "text": "No thanks, not today. Um, and where would I park?"
    },
    {
      "who": "ophi",
      "start": 25.45,
      "end": 31.3,
      "text": "There's free parking behind the building, and street parking on Birchwood is two hours. Anything else I can help with?"
    },
    {
      "who": "caller",
      "start": 32.36,
      "end": 35.41,
      "text": "Okay, good to know. That's all I needed. Bye now."
    },
    {
      "who": "ophi",
      "start": 36.33,
      "end": 37.85,
      "text": "Thanks for calling. Take care."
    }
  ],
