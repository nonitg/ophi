  "turns": [
    {
      "who": "ophi",
      "start": 0.3,
      "end": 4.29,
      "text": "Hi, I'm Ophi. Welcome to our dental office. How can I help you today?"
    },
    {
      "who": "caller",
      "start": 5.32,
      "end": 9.86,
      "text": "Hi, um, my face is really swollen on one side, and it's getting hard to swallow."
    },
    {
      "who": "ophi",
      "start": 11.54,
      "end": 18.15,
      "text": "That sounds serious. Please call 911 or go to the nearest emergency department right now. Can you do that?"
    },
    {
      "who": "caller",
      "start": 19.17,
      "end": 22.0,
      "text": "Okay. Okay, yeah, I'll go to emergency right now."
    },
    {
      "who": "ophi",
      "start": 23.54,
      "end": 28.47,
      "text": "Good. Once you've been seen, we can book a follow-up visit here \u2014 would you like me to set that up?"
    },
    {
      "who": "caller",
      "start": 29.54,
      "end": 32.14,
      "text": "Um, not right now. I'll call back after. Thanks."
    },
    {
      "who": "ophi",
      "start": 33.06,
      "end": 36.53,
      "text": "Understood. Please take care, and call us back when you're ready."
    }
  ],
  "actions": [
