  "turns": [
    {
      "who": "ophi",
      "start": 0.3,
      "end": 4.13,
      "text": "Hi, I'm Ophi. Welcome to our dental office. How can I help you today?"
    },
    {
      "who": "caller",
      "start": 5.34,
      "end": 7.57,
      "text": "Hi! Um, are you taking new patients right now?"
    },
    {
      "who": "ophi",
      "start": 8.36,
      "end": 12.94,
      "text": "Yes, we're accepting new patients of all ages. Would you like to book a first visit?"
    },
    {
      "who": "caller",
      "start": 14.07,
      "end": 16.01,
      "text": "Yes, please. I've never been there before."
    },
    {
      "who": "ophi",
      "start": 17.18,
      "end": 19.77,
      "text": "Sure. Can I get your full name and date of birth?"
    },
    {
      "who": "caller",
      "start": 20.87,
      "end": 23.9,
      "text": "It's Nadia Brennan, April third, nineteen ninety-one."
    },
    {
      "who": "ophi",
      "start": 25.37,
      "end": 28.42,
      "text": "Thank you. Could you spell your first and last name for me?"
    },
    {
      "who": "caller",
      "start": 29.47,
      "end": 33.65,
      "text": "Sure. N, A, D, I, A. And Brennan is B, R, E, N, N, A, N."
    },
    {
      "who": "ophi",
      "start": 35.24,
      "end": 38.38,
      "text": "Thank you. Can I use the number you're calling from for your file?"
    },
    {
      "who": "caller",
      "start": 39.56,
      "end": 41.45,
      "text": "Yeah, you can use the number I'm calling from."
    },
    {
      "who": "ophi",
      "start": 42.8,
      "end": 47.01,
      "text": "Do you have an insurance carrier you'd like us to note, or would you prefer to leave that blank?"
    },
    {
      "who": "caller",
      "start": 48.07,
      "end": 50.06,
      "text": "Yes, it's Canada Life, through my work."
    },
    {
      "who": "ophi",
      "start": 51.66,
      "end": 62.42,
      "text": "Thank you. Let me check our first-visit openings. I have Wednesday, November 11th at 3 PM, or Thursday, November 12th at 8 AM. Which works better for you?"
    },
    {
      "who": "caller",
      "start": 63.63,
      "end": 64.48,
      "text": "The first one, please."
    },
    {
      "who": "ophi",
      "start": 65.74,
      "end": 73.34,
      "text": "It's requested for Wednesday, November 11th at 3 PM, and you'll get a text once the clinic confirms. Is there anything else I can help with?"
    },
    {
      "who": "caller",
      "start": 74.48,
      "end": 75.86,
      "text": "No, that's all. Thanks so much!"
    },
    {
      "who": "ophi",
      "start": 76.78,
      "end": 78.35,
      "text": "Thanks for calling. Take care."
    }
  ],
