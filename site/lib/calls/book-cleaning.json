      "who": "ophi",
      "start": 16.92,
      "end": 25.72,
      "text": "Thanks, Alex, I've got your file. I have Tuesday, November 10th at 4 PM, or Wednesday, November 11th at 3 PM. Which works better?"
    },
    {
      "who": "caller",
      "start": 26.91,
      "end": 28.14,
      "text": "Oh, the first one works for me."
    },
    {
      "who": "ophi",
      "start": 29.6,
      "end": 37.01,
      "text": "It's requested for Tuesday, November 10th at 4 PM, and you'll get a text once the clinic confirms. Is there anything else I can help with?"
    },
    {
      "who": "caller",
      "start": 38.1,
      "end": 39.62,
      "text": "No, that's it. Thanks so much. Bye."
    },
    {
      "who": "ophi",
      "start": 40.73,
      "end": 42.4,
      "text": "Goodbye, Alex. Take care."
    }
