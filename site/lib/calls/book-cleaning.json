      "end": 4.2,
      "text": "Hi, I'm Ophi. Welcome to our dental office. How can I help you today?"
    },
    {
      "who": "caller",
      "start": 5.32,
      "end": 7.02,
      "text": "Hi, um, I'd like to book a cleaning, please."
