    {
      "who": "ophi",
      "start": 0.3,
      "end": 4.18,
      "text": "Hi, I'm Ophi. Welcome to our dental office. How can I help you today?"
    },
    {
      "who": "caller",
      "start": 5.56,
      "end": 8.32,
      "text": "Hello, dear. I need to move my appointment, please."
    },
    {
      "who": "ophi",
      "start": 10.47,
      "end": 13.21,
      "text": "Of course. Could I get your full name and date of birth?"
    },
    {
      "who": "caller",
      "start": 14.42,
      "end": 20.1,
      "text": "Yes, I'm a patient there. It's Margaret Okafor, June twenty-first, nineteen forty-six."
    },
    {
      "who": "ophi",
      "start": 21.71,
      "end": 29.41,
      "text": "Thanks, Margaret. I see a dental exam on Thursday, November 12th at 1:30 PM with Dr. Shah. When would you like to move it to?"
    },
    {
      "who": "caller",
      "start": 30.83,
      "end": 34.62,
      "text": "Sorry, dear, could you slow down a bit? I didn't catch that."
    },
    {
      "who": "ophi",
      "start": 37.58,
      "end": 46.26,
      "text": "Of course. You have a dental exam on Thursday, November 12th, at 1:30 in the afternoon, with Dr. Shah. Which day would you like to move it to?"
    },
    {
      "who": "caller",
      "start": 47.52,
      "end": 51.24,
      "text": "Oh, um, sometime the week after, in the morning if you can."
    },
    {
      "who": "ophi",
      "start": 52.77,
      "end": 60.59,
      "text": "I have Monday, November 16th at 9 AM, or Tuesday, November 17th at 11 AM. Would either of those work?"
    },
    {
      "who": "caller",
      "start": 61.83,
      "end": 63.24,
      "text": "The first one, please, dear."
    },
    {
      "who": "ophi",
      "start": 65.63,
      "end": 73.33,
      "text": "It's requested for Monday, November 16th at 9 AM, and you'll get a text once the clinic confirms. Is there anything else I can help with?"
    },
    {
      "who": "caller",
      "start": 74.52,
      "end": 76.76,
      "text": "No, that's all, thank you dear, goodbye."
    },
    {
      "who": "ophi",
      "start": 77.52,
      "end": 79.22,
      "text": "Goodbye, Margaret. Take care."
    }
