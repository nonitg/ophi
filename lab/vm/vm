#!/bin/bash
# vm — one command surface for the ABELDent lab VM.
#
# Two transports. On macOS/UTM: the QEMU guest agent via utmctl — zero configuration inside
# the guest, survives reboots, works before networking is set up; commands run as
# NT AUTHORITY\SYSTEM. Elsewhere (e.g. a Linux-hosted VM): SSH to host alias $VM_SSH as the
# logged-on user (setup: lab/vm/install_key.ps1). Either way, anything needing the desktop
# (screenshots, UI automation) bounces through a scheduled task in the interactive session.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
LAB="$(cd "$HERE/.." && pwd)"
UTMCTL="${UTMCTL:-/Applications/UTM.app/Contents/MacOS/utmctl}"
VM_UUID="${VM_UUID:-44469FC2-B636-412D-8441-9A4A9B04E537}"
VM_SSH="${VM_SSH:-abelvm}"
VM_TRANSPORT="${VM_TRANSPORT:-$([ -x "$UTMCTL" ] && echo utm || echo ssh)}"
SSH_OPTS=(-o BatchMode=yes -o LogLevel=ERROR -o ConnectTimeout=5)
GUEST_DIR='C:\ophi'

CMD_EXE='C:\Windows\System32\cmd.exe'

die() { echo "error: $*" >&2; exit 1; }

# Guest primitives — every command below is built on these three.
scp_path() { printf '%s:%s' "$VM_SSH" "${1//\\//}"; }
g_push() {  # stdin -> guest file
  if [ "$VM_TRANSPORT" = utm ]; then "$UTMCTL" file push "$VM_UUID" "$1"; return; fi
  local t rc; t="$(mktemp)"; cat > "$t"
  scp -q "${SSH_OPTS[@]}" "$t" "$(scp_path "$1")"; rc=$?; rm -f "$t"; return $rc
}
g_pull() {  # guest file -> stdout
  if [ "$VM_TRANSPORT" = utm ]; then "$UTMCTL" file pull "$VM_UUID" "$1"; return; fi
  local t rc; t="$(mktemp)"
  scp -q "${SSH_OPTS[@]}" "$(scp_path "$1")" "$t" && cat "$t"; rc=$?; rm -f "$t"; return $rc
}
g_cmd() {   # cmd.exe command line in the guest
  if [ "$VM_TRANSPORT" = utm ]; then "$UTMCTL" exec "$VM_UUID" --cmd "$CMD_EXE" /c "$1"; return; fi
  ssh "${SSH_OPTS[@]}" "$VM_SSH" "$1"
}

# The guest side is a single shared mailbox (_cmd.ps1/_last.txt, _ucmd.ps1/_ulast.txt), so two
# host processes talking at once corrupt each other's results. Serialise every guest round trip
# with a mkdir lock; mkdir is atomic on APFS and needs no flock.
LOCK="${TMPDIR:-/tmp}/ophi-vm.lock"
lock() {
  local i
  for i in $(seq 1 3000); do
    if mkdir "$LOCK" 2>/dev/null; then trap 'rmdir "$LOCK" 2>/dev/null' EXIT; return 0; fi
    # Stale lock (holder died): older than 10 minutes.
    if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rmdir "$LOCK" 2>/dev/null; fi
    sleep 0.1
  done
  die "could not acquire $LOCK"
}
unlock() { rmdir "$LOCK" 2>/dev/null; trap - EXIT; }

# schtasks /run is a silent no-op while the previous run is still winding down, so poll the task
# state from the host until it reads Ready. Plain cmd redirection: no quoting to get wrong.
wait_task_idle() {
  local i state
  for i in $(seq 1 60); do
    g_cmd "schtasks /query /tn $1 /fo csv /nh > $GUEST_DIR\\out\\_task.txt 2>&1" >/dev/null 2>&1
    state="$(g_pull "$GUEST_DIR\\out\\_task.txt" 2>/dev/null)"
    case "$state" in *Running*) sleep 0.2 ;; "") sleep 0.2 ;; *) return 0 ;; esac
  done
  echo "task $1 still Running after 12s — a child process (ABELDent?) is holding it; see ophi-lab-vm memory" >&2
  return 1
}

# utmctl exits 0 even when the guest file is still locked by the writer, so success is
# judged on content, not exit code. Each utmctl round trip is ~200ms, which is the delay.
pull_retry() {
  local path="$1" i out
  for i in $(seq 1 "${2:-40}"); do
    out="$(g_pull "$path" 2>/dev/null)"
    if [ -n "$out" ]; then printf '%s\n' "$out"; return 0; fi
  done
  return 1
}

# Run PowerShell in the guest, return its combined output.
# A sentinel line marks completion — without it a partially-flushed file reads as done.
ps_exec() {
  local marker='___OPHI_DONE___' out
  lock
  printf '%s\n%s\n' "$1" "Write-Output '$marker'" \
    | g_push "$GUEST_DIR\\_cmd.ps1" >/dev/null 2>&1 \
    || die "guest agent not responding — is the VM running?"
  g_cmd "del $GUEST_DIR\\out\\_last.txt 2>nul & powershell -NoProfile -ExecutionPolicy Bypass -File $GUEST_DIR\\_cmd.ps1 > $GUEST_DIR\\out\\_last.txt 2>&1" \
    >/dev/null 2>&1
  local i
  for i in $(seq 1 120); do
    out="$(g_pull "$GUEST_DIR\\out\\_last.txt" 2>/dev/null)"
    case "$out" in *"$marker"*) printf '%s\n' "${out%$marker*}"; unlock; return 0 ;; esac
  done
  echo "timed out waiting for guest command" >&2
  printf '%s\n' "$out"
  unlock; return 1
}

# Run PowerShell as the logged-on user instead of SYSTEM, via the OphiRun task.
# Required for anything touching ABELDent's LocalDB or the desktop.
user_exec() {
  local marker='___OPHI_UDONE___' out i
  lock
  printf '%s\n' "$1" | g_push "$GUEST_DIR\\_ucmd.ps1" >/dev/null 2>&1 \
    || die "guest agent not responding"
  # schtasks /run is a silent no-op while the previous run is still exiting, so back-to-back
  # calls used to hang until the pull loop timed out. Wait for the task to go idle first.
  wait_task_idle OphiRun || { unlock; return 1; }
  g_cmd "del $GUEST_DIR\\out\\_ulast.txt 2>nul & schtasks /run /tn OphiRun" >/dev/null 2>&1
  for i in $(seq 1 300); do
    out="$(g_pull "$GUEST_DIR\\out\\_ulast.txt" 2>/dev/null)"
    case "$out" in *"$marker"*) printf '%s\n' "${out%$marker*}"; unlock; return 0 ;; esac
  done
  echo "timed out — is OphiRun registered? run: $0 setup-user" >&2
  printf '%s\n' "$out"; unlock; return 1
}

cmd="${1:-help}"; shift || true

case "$cmd" in

exec)   ps_exec "$*" ;;
uexec)  user_exec "$*" ;;

# One-time: register the task that runs commands in the logged-on user's session.
setup-user)
  ps_exec "\$u = (Get-CimInstance Win32_ComputerSystem).UserName
if (-not \$u) { 'no interactive user logged on'; exit 1 }
# Windows Terminal ignores -WindowStyle Hidden and pops a console over ABELDent, stealing focus
# from UI automation. conhost --headless gives the task a console with no window at all.
\$run = 'C:\\Windows\\System32\\conhost.exe --headless powershell -NoProfile -ExecutionPolicy Bypass -File $GUEST_DIR\\run-user.ps1'
\$shot = 'C:\\Windows\\System32\\conhost.exe --headless powershell -NoProfile -ExecutionPolicy Bypass -File $GUEST_DIR\\shot.ps1'
schtasks /create /tn OphiRun /ru \$u /it /f /sc once /st 00:00 /tr \$run
schtasks /create /tn OphiShot /ru \$u /it /f /sc once /st 00:00 /tr \$shot
'registered for ' + \$u"
  ;;

# Read-only SQL against the ABELDent database.
# Usage: vm sql "<query with @name>" [db] [json|csv|table] ['{"name": value}']
sql)
  q="${1:?usage: vm sql \"<query>\" [database] [json|csv|table] [params-json]}"
  db="${2:-master}"; as="${3:-table}"
  q_b64="$(printf '%s' "$q" | base64 | tr -d '\n')"
  args="-Database $db -As $as"
  [ -n "${4:-}" ] && args+=" -ParamsB64 $(printf '%s' "$4" | base64 | tr -d '\n')"
  # Must run as the logged-on user — LocalDB instances are per-user. Over ssh we already are.
  if [ "$VM_TRANSPORT" = ssh ]; then
    printf '%s' "$q_b64" | g_cmd "powershell -NoProfile -ExecutionPolicy Bypass -File $GUEST_DIR\\q.ps1 -QueryB64 stdin $args"
  else
    user_exec "& $GUEST_DIR\\q.ps1 -QueryB64 $q_b64 $args"
  fi
  ;;

# Copy the guest-side scripts in.
sync)
  # Plain cmd, not ps_exec: ps_exec's mailbox lives in the directory being created
  g_cmd "if not exist $GUEST_DIR\\out mkdir $GUEST_DIR\\out" >/dev/null
  for f in "$HERE"/guest/*.ps1; do
    g_push "$GUEST_DIR\\$(basename "$f")" < "$f" >/dev/null \
      && echo "pushed $(basename "$f")"
  done
  ;;

push)   g_push "${2:?usage: vm push <local> <guestpath>}" < "${1:?}" && echo "pushed -> $2" ;;
get)    pull_retry "${1:?usage: vm get <guestpath>}" ;;

# Pull a named artifact out of C:\ophi\out into lab/out.
pull)
  mkdir -p "$LAB/out"
  name="${1:?usage: vm pull <filename in C:\\ophi\\out>}"
  pull_retry "$GUEST_DIR\\out\\$name" > "$LAB/out/$name" && echo "$LAB/out/$name"
  ;;

# One-time: register the screenshot task in the interactive session.
setup-shot)
  ps_exec "\$u = (Get-CimInstance Win32_ComputerSystem).UserName
schtasks /create /tn OphiShot /ru \$u /tr 'powershell -NoProfile -WindowStyle Hidden -File $GUEST_DIR\\shot.ps1' /sc once /st 00:00 /it /f
'registered for ' + \$u"
  ;;

# Capture the guest desktop into lab/out and print the path.
shot)
  mkdir -p "$LAB/out"
  ts="$(date +%H%M%S)"
  ps_exec "Remove-Item $GUEST_DIR\\out\\shot.png -ErrorAction SilentlyContinue
schtasks /run /tn OphiShot | Out-Null
for (\$i=0; \$i -lt 30; \$i++) { if (Test-Path $GUEST_DIR\\out\\shot.png) { break }; Start-Sleep -Milliseconds 300 }
if (Test-Path $GUEST_DIR\\out\\shot.png) { 'ok' } else { 'FAILED - run: vm setup-shot' }" >/dev/null
  g_pull "$GUEST_DIR\\out\\shot.png" > "$LAB/out/shot-$ts.png" 2>/dev/null
  if [ -s "$LAB/out/shot-$ts.png" ]; then echo "$LAB/out/shot-$ts.png"
  else rm -f "$LAB/out/shot-$ts.png"; die "no screenshot — run: $0 setup-shot"; fi
  ;;

inspect) ps_exec "& $GUEST_DIR\\inspect.ps1" ;;

status)
  echo "transport: $VM_TRANSPORT"
  if [ "$VM_TRANSPORT" = utm ]; then
    "$UTMCTL" status "$VM_UUID"
    "$UTMCTL" ip-address "$VM_UUID" 2>/dev/null | head -1
  else
    g_cmd "hostname" && echo "reachable as $VM_SSH"
  fi
  ;;

help|*)
  cat <<'EOF'
vm <command>

  exec '<powershell>'   run PowerShell in the guest (as SYSTEM), print output
  sql '<query>' [db] [json|csv|table] ['{"name": value}']
                        read-only query against the ABELDent database; @name params bind
  sync                  push lab/vm/guest/*.ps1 into C:\ophi
  push <local> <guest>  copy a file in
  get <guestpath>       print a guest file to stdout
  pull <name>           copy C:\ophi\out\<name> -> lab/out/
  setup-shot            one-time: register the screenshot task
  shot                  capture the guest desktop -> lab/out/
  inspect               run the Step-0 recon script
  status                transport + VM power state/reachability

  env: VM_TRANSPORT=utm|ssh (default: utm if utmctl exists), VM_SSH=<ssh host alias> (abelvm)
EOF
  ;;
esac
